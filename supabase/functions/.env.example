# Copia este archivo a supabase/functions/.env SOLO para pruebas locales:
#   supabase functions serve --env-file supabase/functions/.env
#
# En producción configúralas con:
#   supabase secrets set MP_ACCESS_TOKEN="APP_USR-..." MP_WEBHOOK_SECRET="..." SITE_URL="https://tudominio.com"
#
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY las inyecta
# Supabase automáticamente en las Edge Functions (no las pongas aquí).

# Access token de Mercado Pago (privado, nunca en el frontend).
MP_ACCESS_TOKEN=

# Clave secreta del webhook (Panel de Mercado Pago > Webhooks > Clave secreta).
MP_WEBHOOK_SECRET=

# URL pública del sitio (sin barra final). Ej: https://pasionmotors.com
SITE_URL=

# Orígenes permitidos para CORS (separados por coma). Si se omite, usa SITE_URL.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Correo · recuperación de contraseña
# ---------------------------------------------------------------------------
# OPCIÓN RECOMENDADA: Resend (envía el correo directo, sin plantillas externas).
# 1) Crea una cuenta en https://resend.com
# 2) Verifica tu dominio y usa un remitente de ese dominio.
# 3) Crea una API key y configura:
RESEND_API_KEY=
RESET_FROM_EMAIL=PASION MOTORS <no-reply@tudominio.com>
# Remitente para confirmaciones y guías de envío (si se omite usa RESET_FROM_EMAIL).
ORDER_FROM_EMAIL=PASION MOTORS <no-reply@tudominio.com>
# Opcional: mientras verificas tu dominio, envía todos los correos a este buzón.
ORDER_EMAIL_TEST_TO=

# ALTERNATIVA: EmailJS (requiere una plantilla con las variables to_email y passcode).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Secreto largo y aleatorio para hashear los códigos (nunca lo compartas).
# Genera uno con:  [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
PASSWORD_RESET_PEPPER=

