# Copia este archivo a .env.local y completa tus credenciales.
# Solo estas dos variables llegan al navegador (son públicas por diseño).
VITE_SUPABASE_URL=tu-url-de-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ⚠️ NUNCA agregues aquí SUPABASE_SERVICE_ROLE_KEY, MP_ACCESS_TOKEN ni ningún
# secreto con prefijo VITE_: todo lo que empieza por VITE_ se incluye en el
# JavaScript público del sitio. Los secretos viven solo en Supabase Edge
# Functions (ver SEGURIDAD.md).
